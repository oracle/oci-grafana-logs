{
  "name": "oci-logs-datasource",
  "private": true,
  "version": "5.0.5",
  "description": "Oracle Cloud Infrastructure Logs Data Source for Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "yarn cypress install && yarn grafana-e2e run",
    "e2e:update": "yarn cypress install && yarn grafana-e2e run --update-screenshots",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "yarn watch",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn run lint --fix"
  },
  "author": "",
  "license": "UPL-1.0",
  "engines": {
    "node": ">=20"
  },
  "engineStrict": true,
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "7.24.1",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^1.2.0-rc1",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "4.14.195",
    "@types/node": "^20.8.7",
    "@types/react-router-dom": "^5.2.0",
    "@types/testing-library__jest-dom": "5.14.8",
    "@typescript-eslint/eslint-plugin": "6.18.1",
    "@typescript-eslint/parser": "6.18.1",
    "babel-loader": "^8.0.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-jsdoc": "46.8.2",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-scope": "^5.1.1",
    "eslint-utils": "^2.1.0",
    "eslint-visitor-keys": "^2.1.0",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.5.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.5.0",
    "minimatch": "3.1.5",
    "prettier": "^2.8.7",
    "prunk": "^1.3.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "4.8.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "dependencies": {
    "@apache-arrow/es5-cjs": "^4.0.1",
    "@babel/preset-env": "^7.29.5",
    "@emotion/css": "11.10.6",
    "@grafana/data": "^10.4.10",
    "@grafana/runtime": "^10.4.10",
    "@grafana/schema": "^10.4.10",
    "@grafana/ui": "^10.4.10",
    "js-yaml": "^3.13.1",
    "lodash": "4.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tslib": "2.5.3"
  },
  "resolutions": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "d3-color": "3.1.0",
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "form-data": "4.0.4",
    "immutable": "4.3.8",
    "lodash": "4.18.0",
    "protobufjs": "7.5.8",
    "@typescript-eslint/typescript-estree/minimatch": "9.0.9",
    "eslint-plugin-deprecation/@typescript-eslint/utils/@typescript-eslint/typescript-estree/minimatch": "9.0.9",
    "picomatch": "2.3.2",
    "serialize-javascript": "7.0.5",
    "uplot": "1.6.31"
  },
  "packageManager": "yarn@1.22.21"
}
